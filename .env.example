# GitStreak AI Environment Configuration
PORT=3000

# ----------------- DATABASE (MONGODB) -----------------
# Paste your MongoDB connection string (Atlas or self-hosted)
# If left empty, GitStreak automatically uses local persistent storage.
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/gitstreak?retryWrites=true&w=majority
MONGODB_URI=

# ----------------- GITHUB OAUTH AUTHENTICATION -----------------
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL: https://<your-deployed-domain>/api/auth/github/callback
# (For local dev: http://localhost:3000/api/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
JWT_SECRET=super-secret-jwt-key-change-in-production

# ----------------- GEMINI AI CONFIGURATION -----------------
# Optional server-wide fallback Google Gemini API Key.
GEMINI_API_KEY=

# ----------------- CRON SECURITY (OPTIONAL) -----------------
# Optional secret for cron-job.org /api/cron/trigger?secret=...
CRON_SECRET=
